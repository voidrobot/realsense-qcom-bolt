#version 450
#extension GL_GOOGLE_include_directive : require
#include "common_math.glsl"

layout(local_size_x = 16, local_size_y = 16) in;
layout(constant_id = 0) const uint ORDERED_PC = 0u;

layout(std430, binding = 0) readonly buffer DepthIn { uint depth_in[]; };
layout(std430, binding = 1) readonly buffer CalibBuf { CalibData calib; };
layout(std430, binding = 2) writeonly buffer PcOut { float pc_out[]; };
layout(std430, binding = 3) buffer CounterBuf { uint valid_count[]; };

BOLT_DECLARE_COMPACTION_SHARED

void main()
{
    BOLT_COMPACTION_INIT(ORDERED_PC)

    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint dw = uint(calib.depth_intrin.width);
    uint dh = uint(calib.depth_intrin.height);
    bool in_bounds = (x < dw && y < dh);

    bool valid = false;
    vec3 pt = vec3(0.0);

    if (in_bounds)
    {
        uint idx = y * dw + x;
        uint word = depth_in[idx >> 1u];
        uint raw_z = ((idx & 1u) == 0u) ? (word & 0xFFFFu) : (word >> 16u);
        float z_m = float(raw_z) * calib.depth_scale;
        if (raw_z > 0u && z_m >= calib.min_depth_m &&
            (calib.max_depth_m <= 0.0 || z_m <= calib.max_depth_m))
        {
            pt = deproject_pixel_to_point(calib.depth_intrin, vec2(float(x), float(y)), z_m);
            valid = true;
        }
    }

    if (ORDERED_PC != 0u)
    {
        if (in_bounds)
        {
            uint base = (y * dw + x) * 3u;
            pc_out[base] = pt.x;
            pc_out[base + 1u] = pt.y;
            pc_out[base + 2u] = pt.z;
        }
        return;
    }

    BOLT_COMPACTION_RESERVE(valid, valid_count, dst_idx)
    if (valid)
    {
        uint base = dst_idx * 3u;
        pc_out[base] = pt.x;
        pc_out[base + 1u] = pt.y;
        pc_out[base + 2u] = pt.z;
    }
}
