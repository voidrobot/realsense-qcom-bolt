#version 450
#extension GL_GOOGLE_include_directive : require
#include "common_math.glsl"

// P5: Fused Color-frame XYZRGB PointCloud directly from Aligned Depth ZBuf + RGB8.
layout(local_size_x = 16, local_size_y = 16) in;
layout(constant_id = 0) const uint ORDERED_PC = 0u;

layout(std430, binding = 0) readonly buffer ZBuf { uint zbuf[]; };
layout(std430, binding = 1) readonly buffer RgbIn { uint rgb_in[]; };
layout(std430, binding = 2) readonly buffer CalibBuf { CalibData calib; };
layout(std430, binding = 3) writeonly buffer PcOut { uvec4 pc_out[]; };
layout(std430, binding = 4) buffer CounterBuf { uint valid_count[]; };

BOLT_DECLARE_COMPACTION_SHARED

void main()
{
    BOLT_COMPACTION_INIT(ORDERED_PC)

    uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    uint cw = uint(calib.color_intrin.width);
    uint ch = uint(calib.color_intrin.height);
    bool in_bounds = (x < cw && y < ch);

    bool valid = false;
    uvec4 out_pt = uvec4(0u);

    if (in_bounds)
    {
        uint raw_z = zbuf[y * cw + x];
        if (raw_z != 0xFFFFFFFFu && raw_z > 0u)
        {
            float z_m = float(raw_z) * calib.depth_scale;
            vec3 pt = deproject_pixel_to_point(calib.color_intrin, vec2(float(x), float(y)), z_m);
            uint byte_off = y * calib.color_stride_bytes + x * 3u;
            uvec3 rgb = BOLT_LOAD_RGB8(rgb_in, byte_off);
            uint bgr = pack_rgb_as_ros_bgr(rgb);
            out_pt = uvec4(floatBitsToUint(pt.x), floatBitsToUint(pt.y), floatBitsToUint(pt.z), bgr);
            valid = true;
        }
    }

    if (ORDERED_PC != 0u)
    {
        if (in_bounds)
        {
            pc_out[y * cw + x] = out_pt;
        }
        return;
    }

    BOLT_COMPACTION_RESERVE(valid, valid_count, dst_idx)
    if (valid)
    {
        pc_out[dst_idx] = out_pt;
    }
}
