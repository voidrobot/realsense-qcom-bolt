<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>realsense_qcom_bolt</name>
  <version>1.0.0</version>
  <description>Fixed Vulkan 1.3 Compute RGB-D pipeline set for Intel RealSense with optional Qualcomm QIRP DMA-BUF Zero-Copy transport.</description>
  <maintainer email="void@voidrobot.dev">void</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>librealsense2</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
